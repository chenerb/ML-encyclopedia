---
interface Props {
  icon: string;
  title: string;
  description: string;
  href: string;
  count: number;
  gradient: { from: string; to: string; glow: string };
}

const { icon, title, description, href, count, gradient } = Astro.props;
---

<a
  href={href}
  class="group relative block p-6 rounded-2xl cursor-pointer transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] bg-white dark:bg-white/[0.03] border border-gray-200 dark:border-white/[0.06] hover:border-gray-300 dark:hover:border-white/[0.12] hover:shadow-xl hover:-translate-y-1"
  style={`--card-from: ${gradient.from}; --card-to: ${gradient.to}; --card-glow: ${gradient.glow};`}
>
  <div
    class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
    style={`background: radial-gradient(ellipse at 50% 0%, ${gradient.glow}, transparent 70%);`}
  ></div>

  <div
    class="absolute top-0 left-6 right-6 h-[2px] rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300"
    style={`background: linear-gradient(90deg, ${gradient.from}, ${gradient.to});`}
  ></div>

  <div class="relative z-10">
    <div
      class="w-10 h-10 rounded-xl flex items-center justify-center mb-4 text-xl transition-transform duration-300 group-hover:scale-110"
      style={`background: linear-gradient(135deg, ${gradient.from}20, ${gradient.to}20);`}
    >
      <span>{icon}</span>
    </div>

    <h3
      class="text-base font-semibold text-gray-900 dark:text-white mb-1.5 transition-colors duration-200"
    >
      <span class="group-hover:hidden">{title}</span>
      <span
        class="hidden group-hover:inline bg-clip-text text-transparent"
        style={`background-image: linear-gradient(to right, ${gradient.from}, ${gradient.to});`}
      >
        {title}
      </span>
    </h3>

    <p class="text-sm text-gray-500 dark:text-gray-400 mb-4 line-clamp-2 leading-relaxed">
      {description}
    </p>

    <div class="flex items-center justify-between">
      <span class="text-xs font-medium text-gray-400 dark:text-gray-500">{count} 篇文章</span>
      <span
        class="flex items-center gap-1 text-xs font-medium opacity-0 group-hover:opacity-100 transition-all duration-300 translate-x-[-4px] group-hover:translate-x-0"
        style={`color: ${gradient.from};`}
      >
        探索
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </span>
    </div>
  </div>
</a>
