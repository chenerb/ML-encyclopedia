---
import { CHAPTERS, getGroupLabel } from '../utils/chapters';
import { articlePath, getPath, type ArticleMeta } from '../utils/paths';

interface Props {
  articles: ArticleMeta[];
  currentId: string;
}

const { articles, currentId } = Astro.props;

// 当前文章所在章节
const currentChapter = currentId.split('/')[0];

const isActive = (id: string) => id === currentId;
---

<nav class="sidebar-scroll overflow-y-auto text-sm">
  {
    CHAPTERS.map((chapter) => {
      const chapterArticles = articles.filter((a) => a.chapter === chapter.slug);
      const isCurrentChapter = chapter.slug === currentChapter;
      return (
        <div class="mb-1">
          <!-- 章节标题（可折叠） -->
          <details open={isCurrentChapter} class="group">
            <summary class="flex items-center justify-between gap-2 py-2 px-3 rounded-lg cursor-pointer select-none hover:bg-gray-100/70 dark:hover:bg-white/[0.04] transition-colors list-none">
              <a
                href={getPath(`/docs/${chapter.slug}`)}
                class={`flex-1 font-semibold ${isCurrentChapter ? 'text-gray-900 dark:text-white' : 'text-gray-700 dark:text-gray-300'}`}
              >
                <span class="mr-1.5">{chapter.icon}</span>
                {chapter.label}
              </a>
              <svg
                class={`w-3.5 h-3.5 text-gray-400 transition-transform ${isCurrentChapter ? 'rotate-0' : '-rotate-90'}`}
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>

            <!-- 章节内文章列表 -->
            {chapter.groups ? (
              /* 第五章：按子分组展示 */
              chapter.groups.map((group) => {
                const groupArticles = chapterArticles.filter((a) => a.group === group.slug);
                if (groupArticles.length === 0) return null;
                return (
                  <div class="mt-0.5">
                    <p class="px-3 py-1.5 text-[11px] font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wide">
                      {group.label}
                    </p>
                    <ul class="space-y-0.5">
                      {groupArticles.map((a) => (
                        <li>
                          <a
                            href={articlePath(a)}
                            class={`block py-1.5 pl-5 pr-3 rounded-lg text-[13px] leading-snug transition-colors ${
                              isActive(a.id)
                                ? 'font-semibold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-500/10'
                                : 'text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100/70 dark:hover:bg-white/[0.04]'
                            }`}
                          >
                            {a.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                );
              })
            ) : (
              <ul class="space-y-0.5">
                {chapterArticles.map((a) => (
                  <li>
                    <a
                      href={articlePath(a)}
                      class={`block py-1.5 pl-5 pr-3 rounded-lg text-[13px] leading-snug transition-colors ${
                        isActive(a.id)
                          ? 'font-semibold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-500/10'
                          : 'text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100/70 dark:hover:bg-white/[0.04]'
                      }`}
                    >
                      {a.title}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </details>
        </div>
      );
    })
  }
</nav>
