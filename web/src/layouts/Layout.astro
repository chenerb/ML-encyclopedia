---
import '@fontsource/inter';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import Search from '../components/Search.astro';
import CopyButton from '../components/CopyButton.astro';
import { getPath } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '机器学习到深度学习演变百科全书',
  description = '系统全面、通俗易懂的机器学习与深度学习教程：从传统算法到前沿大模型，构建完整的知识体系',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const navModules = [
  { label: '引言', href: '/docs/01-introduction' },
  { label: '数学基础', href: '/docs/02-mathematics' },
  { label: '传统机器学习', href: '/docs/03-traditional-ml' },
  { label: '深度学习', href: '/docs/05-deep-learning' },
  { label: '里程碑模型', href: '/docs/06-milestone-models' },
  { label: '实践指南', href: '/docs/07-practical-guide' },
];

const allChapters = [
  { label: '第一章：引言', href: '/docs/01-introduction' },
  { label: '第二章：数学基础', href: '/docs/02-mathematics' },
  { label: '第三章：传统机器学习', href: '/docs/03-traditional-ml' },
  { label: '第四章：神经网络基础', href: '/docs/04-neural-networks' },
  { label: '第五章：深度学习', href: '/docs/05-deep-learning' },
  { label: '第六章：里程碑模型', href: '/docs/06-milestone-models' },
  { label: '第七章：实践指南', href: '/docs/07-practical-guide' },
  { label: '第八章：应用领域', href: '/docs/08-applications' },
  { label: '第九章：学习资源', href: '/docs/09-resources' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href) || currentPath.startsWith(getPath(href));

const navLinkClass = (href: string) =>
  isActive(href)
    ? 'nav-link relative text-sm font-semibold text-gray-900 dark:text-white transition-colors duration-200 py-1 cursor-pointer'
    : 'nav-link relative text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors duration-200 py-1 cursor-pointer';

const navLinkIndicator = (href: string) =>
  isActive(href)
    ? 'absolute -bottom-[22px] left-0 right-0 h-[2px] bg-gradient-to-r from-[#6366f1] to-[#a855f7] rounded-full'
    : 'absolute -bottom-[22px] left-0 right-0 h-[2px] bg-gradient-to-r from-[#6366f1] to-[#a855f7] rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center';

const mobileNavLinkClass = (href: string) =>
  isActive(href)
    ? 'mobile-nav-link flex items-center gap-3 py-3 px-4 rounded-xl text-[13px] text-gray-900 dark:text-white bg-gray-100 dark:bg-white/[0.08] transition-all font-semibold cursor-pointer'
    : 'mobile-nav-link flex items-center gap-3 py-3 px-4 rounded-xl text-[13px] text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-white/[0.04] transition-all font-medium cursor-pointer';
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={getPath('/favicon.svg')} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.45/dist/katex.min.css" crossorigin="anonymous" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="机器学习到深度学习演变百科全书" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#6366f1" />

    <script is:inline>
      if (
        localStorage.getItem('color-theme') === 'dark' ||
        (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>

  <body
    class="bg-[#fafafa] dark:bg-[#0a0a0a] text-gray-900 dark:text-gray-100 min-h-screen flex flex-col font-sans transition-colors duration-300"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-[#6366f1] focus:text-white focus:rounded-lg focus:text-sm focus:font-medium"
    >
      跳到主要内容
    </a>

    <header
      id="site-header"
      class="fixed top-0 left-0 right-0 z-50 bg-white/70 dark:bg-white/[0.06] backdrop-blur-xl border-b border-gray-200/50 dark:border-white/[0.08] transition-all duration-300"
    >
      <div class="w-full">
        <nav class="relative flex items-center justify-between h-16 max-w-7xl mx-auto px-6">
          <a href={getPath('/')} class="flex items-center gap-2 text-lg font-bold cursor-pointer shrink-0">
            <span class="w-7 h-7 rounded-lg bg-gradient-to-br from-[#6366f1] to-[#a855f7] flex items-center justify-center text-white text-sm">
              ML
            </span>
            <span class="bg-gradient-to-r from-[#6366f1] to-[#a855f7] bg-clip-text text-transparent">
              机器学习百科全书
            </span>
          </a>

          <div class="hidden lg:flex items-center">
            <ul class="flex items-center gap-1">
              {navModules.map((mod) => (
                <li class="group">
                  <a href={getPath(mod.href)} class={navLinkClass(mod.href)}>
                    <span class="relative px-3 py-1.5 rounded-lg group-hover:bg-gray-100/70 dark:group-hover:bg-white/[0.06] transition-colors duration-200">
                      {mod.label}
                    </span>
                    <span class={navLinkIndicator(mod.href)} />
                  </a>
                </li>
              ))}
            </ul>

            <div class="w-px h-4 bg-gray-200 dark:bg-white/[0.08] mx-3" />

            <ul class="flex items-center gap-1">
              <li class="group">
                <a href={getPath('/#chapters')} class={navLinkClass('chapters')}>
                  <span class="relative px-3 py-1.5 rounded-lg group-hover:bg-gray-100/70 dark:group-hover:bg-white/[0.06] transition-colors duration-200">
                    全部章节
                  </span>
                </a>
              </li>
            </ul>
          </div>

          <div class="flex items-center gap-0.5">
            <a
              href="https://github.com/chenerb/ML-encyclopedia"
              target="_blank"
              rel="noopener noreferrer"
              class="hidden md:flex p-2 rounded-lg hover:bg-gray-100/70 dark:hover:bg-white/[0.06] transition-colors duration-200 text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white cursor-pointer"
              aria-label="GitHub"
              title="GitHub"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            </a>

            <button
              onclick="document.dispatchEvent(new Event('open-search'))"
              class="p-2 rounded-lg hover:bg-gray-100/70 dark:hover:bg-white/[0.06] transition-colors duration-200 text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white cursor-pointer"
              aria-label="搜索"
              title="搜索 (Cmd/Ctrl + K)"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </button>

            <ThemeToggle />

            <button
              id="mobile-menu-btn"
              class="lg:hidden p-2 rounded-lg hover:bg-gray-100/70 dark:hover:bg-white/[0.06] transition-colors duration-200 cursor-pointer"
              aria-label="菜单"
            >
              <svg id="menu-icon" class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path class="menu-open" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                <path class="menu-close hidden" stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </nav>
      </div>

      <div id="mobile-menu-overlay" class="lg:hidden fixed inset-0 bg-black/40 backdrop-blur-sm z-40 opacity-0 pointer-events-none transition-opacity duration-300"></div>

      <div id="mobile-menu" class="lg:hidden fixed top-0 right-0 h-full w-72 max-w-[80vw] bg-white/95 dark:bg-[#141414]/95 backdrop-blur-xl shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-out">
        <div class="p-6 sidebar-scroll overflow-y-auto h-full">
          <div class="flex justify-between items-center mb-4">
            <span class="text-sm font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">导航</span>
            <button id="mobile-menu-close" class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-white/[0.06] transition-colors cursor-pointer" aria-label="关闭菜单">
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <a href={getPath('/')} class="mobile-nav-link flex items-center gap-3 py-3 px-4 rounded-xl text-[13px] font-semibold text-gray-900 dark:text-white hover:bg-gray-50 dark:hover:bg-white/[0.04] transition-all cursor-pointer mb-2">
            首页
          </a>

          <p class="text-[11px] font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider px-4 mb-2">章节</p>
          <nav class="flex flex-col gap-0.5">
            {allChapters.map((c) => (
              <a href={getPath(c.href)} class={mobileNavLinkClass(c.href)}>{c.label}</a>
            ))}
          </nav>

          <div class="border-t border-gray-100 dark:border-white/[0.06] pt-4 mt-4">
            <a href="https://github.com/chenerb/ML-encyclopedia" target="_blank" rel="noopener noreferrer" class="mobile-nav-link flex items-center gap-3 py-3 px-4 rounded-xl text-[13px] text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-white/[0.04] transition-all font-medium cursor-pointer">
              GitHub
              <svg class="w-3 h-3 ml-auto opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </header>

    <div id="reading-progress" class="fixed top-0 left-0 h-[2px] bg-gradient-to-r from-[#6366f1] via-[#8b5cf6] to-[#d946ef] z-[60] transition-all duration-150 pointer-events-none" style="width: 0%"></div>

    <main id="main-content" class="flex-1 pt-16">
      <slot />
    </main>

    <footer class="bg-white/50 dark:bg-white/[0.02] border-t border-gray-200/60 dark:border-white/[0.06] py-8 mt-auto transition-colors duration-300">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4 mb-5">
          <p class="text-gray-400 dark:text-gray-500 text-xs">© 2025-{new Date().getFullYear()} 机器学习到深度学习演变百科全书 · 开源项目，欢迎贡献！</p>
          <p class="text-gray-400 dark:text-gray-500 text-xs">Built with <a href="https://astro.build" target="_blank" class="text-gray-500 dark:text-gray-400 hover:text-indigo-500 transition-colors text-xs">Astro</a></p>
        </div>
        <div class="flex items-center justify-center gap-4 flex-wrap pt-5 border-t border-gray-200/60 dark:border-white/[0.06]">
          <a href="https://github.com/chenerb/ML-encyclopedia" target="_blank" rel="noopener noreferrer" class="text-gray-400 dark:text-gray-500 hover:text-indigo-500 transition-colors text-xs cursor-pointer">GitHub</a>
          <span class="w-1 h-1 rounded-full bg-gray-300 dark:bg-gray-600"></span>
          <a href="https://github.com/chenerb/ML-encyclopedia/blob/main/SUMMARY.md" target="_blank" rel="noopener noreferrer" class="text-gray-400 dark:text-gray-500 hover:text-indigo-500 transition-colors text-xs cursor-pointer">完整目录</a>
          <span class="w-1 h-1 rounded-full bg-gray-300 dark:bg-gray-600"></span>
          <a href="https://github.com/chenerb/ML-encyclopedia/tree/main/exams" target="_blank" rel="noopener noreferrer" class="text-gray-400 dark:text-gray-500 hover:text-indigo-500 transition-colors text-xs cursor-pointer">测试卷专区</a>
          <span class="w-1 h-1 rounded-full bg-gray-300 dark:bg-gray-600"></span>
          <a href="https://github.com/chenerb/ML-encyclopedia/tree/main/glossary" target="_blank" rel="noopener noreferrer" class="text-gray-400 dark:text-gray-500 hover:text-indigo-500 transition-colors text-xs cursor-pointer">术语表</a>
          <span class="w-1 h-1 rounded-full bg-gray-300 dark:bg-gray-600"></span>
          <a href="https://github.com/chenerb/ML-encyclopedia/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer" class="text-gray-400 dark:text-gray-500 hover:text-indigo-500 transition-colors text-xs cursor-pointer">贡献指南</a>
        </div>
      </div>
    </footer>

    <button
      id="back-to-top"
      class="fixed bottom-8 right-8 w-11 h-11 bg-[#6366f1] hover:bg-[#4f46e5] text-white rounded-full shadow-lg opacity-0 pointer-events-none transition-all duration-300 z-50 flex items-center justify-center"
      aria-label="回到顶部"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
      </svg>
    </button>

    <script>
      const progressBar = document.getElementById('reading-progress');
      const backToTopBtn = document.getElementById('back-to-top');
      const header = document.getElementById('site-header');

      window.addEventListener('scroll', () => {
        const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
        if (progressBar) progressBar.style.width = scrolled + '%';
        if (header) {
          header.classList.toggle('is-scrolled', winScroll > 20);
        }
        if (winScroll > 500) {
          backToTopBtn?.classList.remove('opacity-0', 'pointer-events-none');
          backToTopBtn?.classList.add('opacity-100', 'pointer-events-auto');
        } else {
          backToTopBtn?.classList.remove('opacity-100', 'pointer-events-auto');
          backToTopBtn?.classList.add('opacity-0', 'pointer-events-none');
        }
      });

      backToTopBtn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenuClose = document.getElementById('mobile-menu-close');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
      const menuIcon = document.getElementById('menu-icon');

      function openMenu() {
        mobileMenu?.classList.remove('translate-x-full');
        mobileMenuOverlay?.classList.remove('opacity-0', 'pointer-events-none');
        mobileMenuOverlay?.classList.add('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = 'hidden';
        menuIcon?.querySelector('.menu-open')?.classList.add('hidden');
        menuIcon?.querySelector('.menu-close')?.classList.remove('hidden');
      }
      function closeMenu() {
        mobileMenu?.classList.add('translate-x-full');
        mobileMenuOverlay?.classList.remove('opacity-100', 'pointer-events-auto');
        mobileMenuOverlay?.classList.add('opacity-0', 'pointer-events-none');
        document.body.style.overflow = '';
        menuIcon?.querySelector('.menu-open')?.classList.remove('hidden');
        menuIcon?.querySelector('.menu-close')?.classList.add('hidden');
      }

      mobileMenuBtn?.addEventListener('click', openMenu);
      mobileMenuClose?.addEventListener('click', closeMenu);
      mobileMenuOverlay?.addEventListener('click', closeMenu);
      document.querySelectorAll('.mobile-nav-link').forEach((link) => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });
    </script>

    <Search />
    <CopyButton />

    <script type="module">
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

      function initMermaid() {
        const isDark = document.documentElement.classList.contains('dark');
        mermaid.initialize({ startOnLoad: false, theme: isDark ? 'dark' : 'default', securityLevel: 'loose' });
        const selectors = 'pre[data-language="mermaid"], pre > code.language-mermaid';
        document.querySelectorAll(selectors).forEach((el) => {
          const pre = el.tagName === 'PRE' ? el : el.parentElement;
          const code = pre.querySelector('code') || pre;
          const div = document.createElement('div');
          div.className = 'mermaid';
          div.textContent = code.textContent;
          pre.replaceWith(div);
        });
        mermaid.run();
      }
      initMermaid();
      document.addEventListener('astro:after-swap', initMermaid);
    </script>
  </body>
</html>
