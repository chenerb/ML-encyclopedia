---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CHAPTERS } from '../../utils/chapters';
import { extractTitle, getPath } from '../../utils/paths';
import { examPath, examToArticleId } from '../../utils/content-links.mjs';

const exams = await getCollection('exams');
const ids = new Set(exams.map((entry) => entry.id.replace(/\.md$/, '')));
const specialOrder: Record<string, number> = { '章节测验': 1, '挑战卷': 2, '压力面': 3 };
const pairs = exams
  .filter((entry) => entry.id.replace(/\.md$/, '').endsWith('-题目'))
  .map((entry) => {
    const id = entry.id.replace(/\.md$/, '');
    const [chapter, filename] = id.split('/');
    const stem = filename.replace(/-题目$/, '');
    const answerId = `${chapter}/${stem}-答案解析`;
    const special = Object.hasOwn(specialOrder, stem);
    return {
      id,
      chapter,
      stem,
      answerId: ids.has(answerId) ? answerId : undefined,
      articleId: examToArticleId(id),
      title: extractTitle(entry.body ?? '').replace(/\s*·\s*节末小测$/, ''),
      special,
      type: stem === '章节测验' ? '章节综合卷' : stem === '压力面' ? '压力面问题' : stem === '挑战卷' ? '挑战卷' : '节末小测',
    };
  })
  .sort((a, b) => {
    if (a.chapter !== b.chapter) return a.chapter.localeCompare(b.chapter);
    if (a.special !== b.special) return a.special ? 1 : -1;
    if (a.special) return specialOrder[a.stem] - specialOrder[b.stem];
    return a.stem.localeCompare(b.stem);
  });
const chapters = CHAPTERS.map((chapter) => ({ ...chapter, pairs: pairs.filter((pair) => pair.chapter === chapter.slug) }));
const base = import.meta.env.BASE_URL;
---

<Layout title="配套练习 - 机器学习到深度学习演变百科全书" description="9 章配套练习与详细解析。每节小测、章节综合卷、挑战卷和压力面问题，先做题再对答案，回到正文查漏补缺。">
  <div class="max-w-7xl mx-auto px-6 py-12">
    <div class="max-w-3xl mb-10">
      <a href={getPath('/')} class="inline-flex items-center text-sm text-gray-500 dark:text-gray-400 hover:text-indigo-500 transition-colors mb-7">← 返回首页</a>
      <p class="mb-3 text-xs font-semibold tracking-widest uppercase text-indigo-600 dark:text-indigo-400">学完即测 · 输出倒逼输入</p>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">把读过的知识，变成自己的答案。</h1>
      <p class="text-gray-500 dark:text-gray-400 leading-relaxed">每节小测用于即时巩固，章节综合卷帮你串联概念，再用挑战卷和压力面问题深入练习。先完成题目，再主动打开解析，回到正文补上理解中的空白。</p>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-gray-500 dark:text-gray-400">
        <span><strong class="text-gray-900 dark:text-white">{chapters.length}</strong> 章</span>
        <span><strong class="text-gray-900 dark:text-white">{pairs.length}</strong> 套练习</span>
        <span><strong class="text-gray-900 dark:text-white">{pairs.filter((pair) => pair.answerId).length}</strong> 份配套解析</span>
      </div>
    </div>

    <div class="mb-10 grid gap-3 sm:grid-cols-3">
      {[
        ['01', '先独立作答', '节末小测建议 20–30 分钟；章节综合卷建议 60–90 分钟，具体以卷面说明为准。'],
        ['02', '再核对解析', '记录错题和犹豫过的题目，读懂每个选项与每一步推导背后的原因。'],
        ['03', '回正文讲一遍', '用自己的话解释错题涉及的概念，再回到题目检验是否真正掌握。'],
      ].map(([step, title, description]) => (
        <div class="rounded-2xl border border-gray-200 dark:border-white/[0.08] bg-white dark:bg-white/[0.03] p-5">
          <span class="text-xs font-semibold text-indigo-500 dark:text-indigo-400">{step}</span>
          <h2 class="mt-2 mb-2 font-semibold text-gray-900 dark:text-white">{title}</h2>
          <p class="text-sm leading-relaxed text-gray-500 dark:text-gray-400">{description}</p>
        </div>
      ))}
    </div>

    <div class="flex gap-10">
      <aside class="hidden lg:block w-56 shrink-0 sticky top-24 self-start">
        <nav aria-label="练习章节" class="space-y-1">
          {chapters.map((chapter) => (
            <a href={`#${chapter.slug}`} class="flex items-center justify-between gap-3 rounded-xl px-3 py-2.5 text-sm text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-white/[0.05] hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              <span>{chapter.icon} {chapter.shortLabel}</span>
              <span class="text-xs text-gray-400 dark:text-gray-500">{chapter.pairs.length}</span>
            </a>
          ))}
        </nav>
      </aside>

      <div class="flex-1 min-w-0 space-y-12">
        {chapters.map((chapter) => (
          <section id={chapter.slug} aria-labelledby={`${chapter.slug}-heading`} class="scroll-mt-24">
            <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
              <div>
                <h2 id={`${chapter.slug}-heading`} class="text-xl font-semibold text-gray-900 dark:text-white">{chapter.icon} {chapter.label}</h2>
                <p class="mt-1 text-xs text-gray-400 dark:text-gray-500">{chapter.pairs.filter((pair) => !pair.special).length} 套节末小测 · {chapter.pairs.filter((pair) => pair.special).length} 套综合与进阶练习</p>
              </div>
              <a href={getPath(`/docs/${chapter.slug}/`)} class="text-sm text-indigo-600 dark:text-indigo-400 hover:underline">阅读本章 →</a>
            </div>

            <div class="grid gap-3 sm:grid-cols-2">
              {chapter.pairs.map((pair) => (
                <div class:list={[
                  'flex flex-col rounded-2xl border p-5',
                  pair.special ? 'border-indigo-100 dark:border-indigo-500/20 bg-indigo-50/40 dark:bg-indigo-500/[0.04]' : 'border-gray-200 dark:border-white/[0.08] bg-white dark:bg-white/[0.03]',
                ]}>
                  <p class="mb-2 text-[11px] font-medium text-gray-400 dark:text-gray-500">{pair.type}</p>
                  <h3 class="mb-4 text-sm font-semibold leading-relaxed text-gray-900 dark:text-white">{pair.title}</h3>
                  <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2">
                    <a href={examPath(pair.id, base)} class="inline-flex items-center rounded-lg bg-gray-900 dark:bg-white px-3.5 py-2 text-xs font-semibold text-white dark:text-gray-900 hover:bg-gray-700 dark:hover:bg-gray-100 transition-colors">开始做题 →</a>
                    {pair.answerId && <a href={examPath(pair.answerId, base)} class="text-xs text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">答案解析</a>}
                    {pair.articleId && <a href={getPath(`/docs/${pair.articleId}/`)} class="ml-auto text-xs text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">正文 ↗</a>}
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>
</Layout>
