---
import Layout from '../layouts/Layout.astro';
import { getPath } from '../utils/paths';
---

<Layout title="页面未找到 - 机器学习到深度学习演变百科全书">
  <div class="max-w-xl mx-auto px-6 py-24 text-center">
    <p class="text-7xl font-bold bg-gradient-to-r from-[#6366f1] to-[#d946ef] bg-clip-text text-transparent mb-4">404</p>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">页面未找到</h1>
    <p class="text-gray-500 dark:text-gray-400 mb-8">你访问的页面不存在，可能已被移动或删除。</p>
    <a
      href={getPath('/')}
      class="inline-flex items-center gap-2 px-6 py-3 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-xl font-semibold hover:bg-gray-800 dark:hover:bg-gray-100 transition-all cursor-pointer"
    >
      返回首页
    </a>
  </div>
</Layout>
