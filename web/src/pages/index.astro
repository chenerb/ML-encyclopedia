---
import Layout from '../layouts/Layout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import { getCollection } from 'astro:content';
import { CHAPTERS } from '../utils/chapters';
import { buildArticleIndex, articlePath, getPath } from '../utils/paths';

const articles = buildArticleIndex(await getCollection('docs'));
const firstArticle = articles[0];

const chapterData = CHAPTERS.map((chapter) => ({
  ...chapter,
  count: articles.filter((a) => a.chapter === chapter.slug).length,
}));

const totalArticles = articles.length;
---

<Layout>
  <!-- Hero -->
  <section class="relative pt-28 pb-24 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute inset-0 bg-[linear-gradient(rgba(0,0,0,.03)_1px,transparent_1px),linear-gradient(90deg,rgba(0,0,0,.03)_1px,transparent_1px)] dark:bg-[linear-gradient(rgba(255,255,255,.03)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.03)_1px,transparent_1px)] bg-[size:60px_60px]"></div>
      <div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-indigo-500/[0.08] dark:bg-indigo-500/[0.12] rounded-full blur-[120px]"></div>
      <div class="absolute top-20 right-1/4 w-[400px] h-[400px] bg-violet-500/[0.06] dark:bg-violet-500/[0.10] rounded-full blur-[120px]"></div>
      <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-white dark:from-black to-transparent"></div>
    </div>

    <div class="max-w-4xl mx-auto px-6 text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 rounded-full border border-gray-200 dark:border-white/10 bg-white/80 dark:bg-white/5 backdrop-blur-sm text-sm text-gray-600 dark:text-gray-400">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        开源机器学习与深度学习教程
      </div>

      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold tracking-tight mb-6">
        <span class="bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 dark:from-white dark:via-gray-200 dark:to-white bg-clip-text text-transparent">
          机器学习到深度学习
        </span>
        <span class="block mt-1 bg-gradient-to-r from-[#6366f1] via-[#8b5cf6] to-[#d946ef] bg-clip-text text-transparent">
          演变百科全书
        </span>
      </h1>

      <p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 mb-3 font-medium">
        从感知机到大语言模型，系统梳理人工智能的完整发展脉络
      </p>
      <p class="text-sm text-gray-500 dark:text-gray-500 mb-10 max-w-xl mx-auto leading-relaxed">
        通俗易懂的语言、生活化的类比、寓言故事与费曼自测，帮你真正掌握机器学习与深度学习的核心知识
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        {firstArticle && (
          <a
            href={articlePath(firstArticle)}
            class="group inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-xl font-semibold hover:bg-gray-800 dark:hover:bg-gray-100 transition-all duration-300 shadow-lg shadow-gray-900/10 dark:shadow-white/10 cursor-pointer"
          >
            开始学习
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        )}
        <a
          href="https://github.com/chenerb/ML-encyclopedia"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-white dark:bg-white/5 text-gray-700 dark:text-gray-300 border border-gray-200 dark:border-white/10 rounded-xl font-semibold hover:border-gray-300 dark:hover:border-white/20 hover:bg-gray-50 dark:hover:bg-white/10 transition-all duration-300 cursor-pointer"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          GitHub
        </a>
      </div>

      <div class="flex justify-center gap-10 mt-12">
        <div>
          <p class="text-2xl font-bold text-gray-900 dark:text-white">{CHAPTERS.length}</p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">大章节</p>
        </div>
        <div class="w-px bg-gray-200 dark:bg-white/[0.08]"></div>
        <div>
          <p class="text-2xl font-bold text-gray-900 dark:text-white">{totalArticles}</p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">篇文章</p>
        </div>
        <div class="w-px bg-gray-200 dark:bg-white/[0.08]"></div>
        <div>
          <p class="text-2xl font-bold text-gray-900 dark:text-white">100%</p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">免费开源</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Chapters -->
  <section id="chapters" class="py-20">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-14">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-3">知识库</h2>
        <p class="text-gray-500 dark:text-gray-400 max-w-md mx-auto">九大章节，从数学基础到前沿大模型，系统构建完整知识体系</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {chapterData.map((chapter) => (
          <CategoryCard
            icon={chapter.icon}
            title={chapter.label}
            description={chapter.description}
            href={getPath(`/docs/${chapter.slug}`)}
            count={chapter.count}
            gradient={chapter.gradient}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Features 教学特色 -->
  <section class="py-20 border-t border-gray-100 dark:border-white/[0.04]">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-14">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-3">不只是"知识仓库"</h2>
        <p class="text-gray-500 dark:text-gray-400 max-w-md mx-auto">一套会提问、会讲故事的教学体系</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          [
            { icon: '🧠', title: '费曼学习法', desc: '开篇悬念提问 + 关键概念自问 + 文末自测，倒逼你把知识讲出来', from: '#6366F1', to: '#8B5CF6' },
            { icon: '📖', title: '寓言故事教学', desc: '每个核心概念配一个寓言：盲人下山、死记硬背的考生……让概念住进脑子', from: '#8B5CF6', to: '#EC4899' },
            { icon: '📝', title: '学完即测', desc: '每节小测 + 章节综合卷 + 挑战卷 + 大厂压力面，共 189 份试卷含解析', from: '#F97316', to: '#F59E0B' },
            { icon: '💻', title: '配套代码示例', desc: '手写算法 + 框架实现对照，边学边练，理论落地', from: '#06B6D4', to: '#10B981' },
          ].map((f) => (
            <div class="group relative p-6 rounded-2xl bg-white dark:bg-white/[0.03] border border-gray-200 dark:border-white/[0.06] hover:border-gray-300 dark:hover:border-white/[0.12] hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center text-xl mb-4" style={`background: linear-gradient(135deg, ${f.from}20, ${f.to}20);`}>
                <span>{f.icon}</span>
              </div>
              <h3 class="font-semibold text-gray-900 dark:text-white mb-2">{f.title}</h3>
              <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">{f.desc}</p>
              <div class="absolute top-0 left-6 right-6 h-[2px] rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300" style={`background: linear-gradient(90deg, ${f.from}, ${f.to});`}></div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Learning path -->
  <section class="py-20 border-t border-gray-100 dark:border-white/[0.04]">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-3">推荐学习路径</h2>
        <p class="text-gray-500 dark:text-gray-400 max-w-md mx-auto">由浅入深，循序渐进</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {
          [
            { step: '01', title: '打基础', desc: '引言 → 数学基础 → 传统机器学习', href: '/docs/01-introduction', from: '#3B82F6', to: '#06B6D4' },
            { step: '02', title: '进阶核心', desc: '神经网络基础 → 深度学习五大模型', href: '/docs/04-neural-networks', from: '#8B5CF6', to: '#EC4899' },
            { step: '03', title: '融会贯通', desc: '里程碑模型 → 实践指南 → 应用领域', href: '/docs/06-milestone-models', from: '#F97316', to: '#F59E0B' },
          ].map((item) => (
            <a href={getPath(item.href)} class="group block p-6 rounded-2xl bg-white dark:bg-white/[0.03] border border-gray-200 dark:border-white/[0.06] hover:border-gray-300 dark:hover:border-white/[0.12] hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 cursor-pointer">
              <div class="flex items-center gap-3 mb-3">
                <span
                  class="w-8 h-8 rounded-lg flex items-center justify-center text-sm font-bold text-white"
                  style={`background: linear-gradient(135deg, ${item.from}, ${item.to});`}
                >
                  {item.step}
                </span>
                <h3 class="font-semibold text-gray-900 dark:text-white group-hover:text-indigo-500 dark:group-hover:text-indigo-400 transition-colors">{item.title}</h3>
                <svg class="w-4 h-4 ml-auto text-gray-300 dark:text-gray-600 group-hover:text-indigo-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </div>
              <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">{item.desc}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
